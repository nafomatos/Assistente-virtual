# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# FRED (Federal Reserve Economic Data — free key at https://fred.stlouisfed.org/docs/api/api_key.html)
# Required for the Buffett Indicator (GDP data).
FRED_API_KEY=...

# Twitter/X (https://developer.x.com)
TWITTER_BEARER_TOKEN=...

# YouTube Data API v3 (https://console.cloud.google.com — enable "YouTube Data API v3")
# Fetched only for RED/AMBER tickers (~2 search requests per alerting ticker per day).
YOUTUBE_API_KEY=...

# Gmail (App Password: https://myaccount.google.com/apppasswords)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=...
EMAIL_RECIPIENT=you@gmail.com
